        },
        "kickMember": {
          "$ref": "#/components/messages/kickMember"
        },
        "promoteLeader": {
          "$ref": "#/components/messages/promoteLeader"
        },
        "inviteToParty": {
          "$ref": "#/components/messages/inviteToParty"
        },
        "acceptInvite": {
          "$ref": "#/components/messages/acceptInvite"
        },
        "declineInvite": {
          "$ref": "#/components/messages/declineInvite"
        },
        "matchFound": {
          "$ref": "#/components/messages/matchFound"
        },
        "closeConnection": {
          "$ref": "#/components/messages/closeConnection"
        },
        "searchSuperseded": {
          "$ref": "#/components/messages/searchSuperseded"
        },
        "searchStarted": {
          "$ref": "#/components/messages/searchStarted"
        },
        "error": {
          "$ref": "#/components/messages/error"
        },
        "ping": {
          "$ref": "#/components/messages/ping"
        },
        "partyUpdate": {
          "$ref": "#/components/messages/partyUpdate"
        },
        "partyLeft": {
          "$ref": "#/components/messages/partyLeft"
        },
        "partySearchCancelled": {
          "$ref": "#/components/messages/partySearchCancelled"
        },
        "partyInvite": {
          "$ref": "#/components/messages/partyInvite"
        }
      },
      "bindings": {
        "ws": {
          "method": "GET",
          "query": {
            "type": "object",
            "properties": {
              "ticket": {
                "type": "string",
                "description": "Ticket from `POST /v1/tickets`."
              }
            },
            "required": [
              "ticket"
            ]
          }
        }
      }
    }
  },
