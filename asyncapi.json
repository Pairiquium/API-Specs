  "components": {
    "messages": {
      "beginSearch": {
        "name": "begin_search",
        "title": "Begin search",
        "summary": "Start searching for a match in a game mode.",
        "description": "If the same player already has a search in this game mode on another connection, the new connection takes it over: a search that dropped within the last ~30 seconds resumes with its original search time, and a still-connected older connection receives `SEARCH_SUPERSEDED` and is closed. For ping-based game modes the server replies with `PING` first and the search starts once you answer with `pong`. If the player is in a party, only the party leader can begin a search: it queues the whole party at once (every member needs the matching attribute for the game mode, and the game mode must have parties enabled). For ping-based game modes the server pings every member: each receives a `PING` to answer with `pong`, the party's status is `STARTING` meanwhile, and the search is queued (`SEARCH_STARTED`) once every member has answered, rated by its slowest member. If a member doesn't answer within 10 seconds the check expires with no further message; send `begin_search` again.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "begin_search"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "gameMode": {
                    "type": "string"
                  }
                },
                "required": [
                  "gameMode"
                ]
              }
            },
            "required": [
              "action",
              "payload"
            ]
          }
        }
      },
      "heartbeat": {
        "name": "heartbeat",
        "title": "Heartbeat",
        "summary": "Keep an active search alive.",
        "description": "Searches expire after 3 minutes without a heartbeat. Send one periodically while searching.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "heartbeat"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "cancelSearch": {
        "name": "cancel_search",
        "title": "Cancel search",
        "summary": "Stop the current search.",
        "description": "If the player is in a party, only the party leader can cancel, and it stops the search for the whole party.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "cancel_search"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "pong": {
        "name": "pong",
        "title": "Pong",
        "summary": "Reply to a server `PING`.",
        "description": "Echo the `correlationId` from the `PING` and include the `gameMode`. Reply immediately: round-trip time is measured by the server from its own send time and is used for ping-based matching. The server gives up on a ping check after 10 seconds.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "pong"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "correlationId": {
                    "type": "string"
                  },
                  "gameMode": {
                    "type": "string"
                  }
                },
                "required": [
                  "correlationId",
                  "gameMode"
                ]
              }
            },
            "required": [
              "action",
              "payload"
            ]
          }
        }
      },
      "createParty": {
        "name": "create_party",
        "title": "Create party",
        "summary": "Create a party with you as its leader.",
        "description": "Parties are formed after connecting and before `begin_search`. You receive a `PARTY_UPDATE` containing a `joinCode` to share with friends through your own channels. Creating a party cancels any search you had running on your own. All members must hold tickets for the same region.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "create_party"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "joinParty": {
        "name": "join_party",
        "title": "Join party",
        "summary": "Join a party using its join code.",
        "description": "Every member receives a `PARTY_UPDATE`. A party that is currently searching cannot be joined. Joining cancels any search you had running on your own.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "join_party"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code"
                ]
              }
            },
            "required": [
              "action",
              "payload"
            ]
          }
        }
      },
      "leaveParty": {
        "name": "leave_party",
        "title": "Leave party",
        "summary": "Leave your current party.",
        "description": "You receive `PARTY_LEFT`. If you were the leader, the longest-standing remaining member becomes leader. If the party was searching, the search is cancelled for everyone (`PARTY_SEARCH_CANCELLED`).",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "leave_party"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "kickMember": {
        "name": "kick_member",
        "title": "Kick member",
        "summary": "Remove a player from your party (leader only).",
        "description": "The removed player receives `PARTY_LEFT` with reason `KICKED`. A running search is cancelled for everyone.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "kick_member"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "userId"
                ]
              }
            },
            "required": [
              "action",
              "payload"
            ]
          }
        }
      },
      "promoteLeader": {
        "name": "promote_leader",
        "title": "Promote leader",
        "summary": "Make another member the party leader (leader only).",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "promote_leader"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "userId"
                ]
              }
            },
            "required": [
              "action",
              "payload"
            ]
          }
        }
      },
      "inviteToParty": {
        "name": "invite_to_party",
        "title": "Invite to party",
        "summary": "Invite a player to your party by their `userId` (leader only).",
        "description": "The player must be connected, in the same tenant, and not already in a party; they receive `PARTY_INVITE`. Invites expire after 2 minutes. If the invite can't be delivered you get `PARTY_INVITEE_UNAVAILABLE`, which deliberately doesn't say whether the player is offline or just busy. A party that is searching or starting can't invite.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "invite_to_party"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "userId"
                ]
              }
            },
            "required": [
              "action",
              "payload"
            ]
          }
        }
      },
      "acceptInvite": {
        "name": "accept_invite",
        "title": "Accept invite",
        "summary": "Join the party named by a `PARTY_INVITE` you received.",
        "description": "Only works with a live invite (`PARTY_INVITE_NOT_FOUND` otherwise). Behaves like `join_party` from there.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "accept_invite"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "partyId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "partyId"
                ]
              }
            },
            "required": [
              "action",
              "payload"
            ]
          }
        }
      },
      "declineInvite": {
        "name": "decline_invite",
        "title": "Decline invite",
        "summary": "Discard a `PARTY_INVITE` you received.",
        "description": "Optional, since invites expire on their own. The inviter is not notified.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "decline_invite"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "partyId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "partyId"
                ]
              }
            },
            "required": [
              "action",
              "payload"
            ]
          }
        }
      },
      "matchFound": {
        "name": "MATCH_FOUND",
        "title": "Match found",
        "summary": "A match was made for this player.",
        "description": "Carries the `matchId` and the player's `team`. It does not carry server connection details: your backend receives the match webhook with the same `matchId` and is responsible for getting players to the game server.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "MATCH_FOUND"
              },
              "data": {
                "type": "object",
                "properties": {
                  "metadata": {
                    "type": "object",
                    "properties": {
                      "matchId": {
                        "type": "string"
                      },
                      "team": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "matchId",
                      "team"
                    ]
                  }
                },
                "required": [
                  "metadata"
                ]
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "closeConnection": {
        "name": "CLOSE_CONNECTION",
        "title": "Close connection",
        "summary": "The server is about to close this connection.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "CLOSE_CONNECTION"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "searchSuperseded": {
        "name": "SEARCH_SUPERSEDED",
        "title": "Search superseded",
        "summary": "The same player started a search from a newer connection; this connection is closed.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "SEARCH_SUPERSEDED"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "searchStarted": {
        "name": "SEARCH_STARTED",
        "title": "Search started",
        "summary": "Acknowledges that your search is registered and queued.",
        "description": "Sent after `begin_search` succeeds; for ping-based game modes, after your `pong` completes the search. It carries the `gameMode` and `startedAt` (epoch seconds, the time your wait is measured from). When a party starts searching, every member receives it (with the `partyId`), not just the leader who sent `begin_search`. Repeating `begin_search` on a search that is already running sends it again, so a client that missed it can recover.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "SEARCH_STARTED"
              },
              "data": {
                "type": "object",
                "properties": {
                  "gameMode": {
                    "type": "string"
                  },
                  "startedAt": {
                    "type": "number"
                  },
                  "partyId": {
                    "type": "string"
                  }
                },
                "required": [
                  "gameMode",
                  "startedAt"
                ]
              }
            },
            "required": [
              "action",
              "data"
            ]
          }
        }
      },
      "error": {
        "name": "ERROR",
        "title": "Error",
        "summary": "Something went wrong handling a client message.",
        "description": "Some codes are terminal and the server closes the connection after sending them: `BILLING_ACCESS_DENIED`, `TOKEN_QUOTA_EXCEEDED`, `WAITLIST_ACCESS_DENIED`, `PLAYER_ATTRIBUTE_REQUIRED`. Others (for example `GAME_MODE_NOT_FOUND`, `GAME_MODE_DISABLED`, `STALE_PONG`, `SEARCH_START_FAILED`, `INVALID_MESSAGE`, `INTERNAL_ERROR`) leave the connection open, as do all party errors (`ALREADY_IN_PARTY`, `NOT_IN_PARTY`, `PARTY_NOT_FOUND`, `PARTY_MEMBER_NOT_FOUND`, `PARTY_FULL`, `PARTY_SEARCHING`, `NOT_PARTY_LEADER`, `PARTIES_NOT_ENABLED`, `PARTY_TOO_LARGE`, `PARTY_MEMBER_ATTRIBUTE_MISSING`, `PARTY_CHANGED`, `PARTY_INVITEE_UNAVAILABLE`, `PARTY_INVITE_NOT_FOUND`). `TOKEN_QUOTA_EXCEEDED` means the tenant has used its matched player allowance for the current billing cycle: new searches are rejected, while players already in the queue and matches already made are unaffected.",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "const": "ERROR"
