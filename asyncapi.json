{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Pairiquium Matchmaking WebSocket API",
    "version": "1.1.0",
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "description": "The real-time protocol between a game client and Pairiquium.\n\n**Connecting:** your backend mints a ticket (see the OpenAPI document), then the client opens `<wsEndpoint>?ticket=<ticket>`. Tickets are single-use and expire after 300 seconds, so request a new one for every connection attempt, including reconnects.\n\n**Envelope:** every message is a JSON text frame with an `action` field. Client messages carry extra data in `payload`; server messages carry it in `data`.\n\n**Perspective:** operations are described from the Pairiquium server's point of view. `receive` means the client sends it; `send` means the client receives it.\n\n**Compatibility:** new optional fields may be added to any message. Ignore fields you don't recognise.\n\n**Reconnecting:** if the connection drops mid-search the server holds the search for about 30 seconds. Reconnect with a fresh ticket and send `begin_search` for the same game mode to resume it."
  },
  "servers": {
    "regional": {
      "host": "ws.{region}.pairiquium.com",
      "protocol": "wss",
      "description": "Use the `wsEndpoint` returned with the ticket rather than constructing this yourself.",
      "variables": {
        "region": {
          "description": "Region the ticket is locked to.",
          "examples": [
            "eu-west-2",
            "us-east-1"
          ]
        }
      }
    }
  },
  "channels": {
    "matchmaking": {
      "address": "/",
      "description": "The single WebSocket channel carrying all matchmaking messages.",
      "messages": {
        "beginSearch": {
          "$ref": "#/components/messages/beginSearch"
        },
        "heartbeat": {
